CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_PORT=5678

# Clio data region: us (app.clio.com), eu (eu.app.clio.com), au (au.app.clio.com), ca (ca.app.clio.com).
# Fixed when the Clio account is created; must match the server your firm logs in to.
CLIO_REGION=us

# Advanced overrides. Leave blank to derive them from CLIO_REGION.
CLIO_API_BASE=
CLIO_AUTH_URL=
CLIO_TOKEN_URL=

# Optional: overrides OS keychain (use for CI/headless installs)
ENCRYPTION_KEY=

# stdio (Claude Desktop child process, single user) or http (standalone server). Defaults to http.
TRANSPORT=
MCP_BASE_URL=http://127.0.0.1:3000
# Required in HTTP mode, at least 24 characters. Generate with: openssl rand -hex 32
MCP_API_KEY=
# Local development only. Lets the HTTP server start without MCP_API_KEY. Never set this on a public host.
# MCP_ALLOW_UNAUTHENTICATED=true
