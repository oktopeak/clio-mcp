# BYOC (default): register your own Clio developer app and fill these in.
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
# Listed / App Directory one-click install: set TOKEN_BROKER_URL INSTEAD OF the
# two vars above. Do not set both.
TOKEN_BROKER_URL=
CLIO_REDIRECT_PORT=5678
CLIO_AUTH_URL= https://app.clio.com/oauth/authorize #https://eu.app.clio.com/oauth/authorize
CLIO_TOKEN_URL=https://app.clio.com/oauth/token #https://eu.app.clio.com/oauth/token
CLIO_API_BASE=https://app.clio.com/api/v4 #https://eu.app.clio.com/api/v4
CLIO_REGION=us #eu
# Optional: overrides OS keychain (use for CI/headless installs)
ENCRYPTION_KEY=
TRANSPORT= 
MCP_BASE_URL=http://127.0.0.1:3000
